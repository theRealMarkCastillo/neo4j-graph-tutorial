# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored; never commit real keys. It holds SECRETS only: every other setting
# (endpoints, model names, temperature, names, MLflow) is in config.py.

# --- Neo4j (used by docker compose AND the Python scripts) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Key for the chat endpoint in config.py (LLM_BASE_URL) ---
# Leave empty for a local server (Ollama, LM Studio, vLLM...).
LLM_API_KEY=

# --- Key for the remote embeddings endpoint in config.py (EMBED_BASE_URL, Lesson 19) ---
# Defaults to LLM_API_KEY. Not needed when EMBED_BASE_URL is None (the local model).
EMBED_API_KEY=
