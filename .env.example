# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- Neo4j (used by docker compose AND the Python scripts) ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- OpenAI-compatible chat endpoint (Lesson 5's graphrag.py answer, Lessons 7-12) ---
# Works with OpenAI, OpenRouter, Together, Groq, vLLM, Ollama (http://localhost:11434/v1),
# LM Studio (http://localhost:1234/v1), mlx_lm.server (http://localhost:8080/v1), ...
# The model must support tool calling for Lesson 7.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Optional: a cheaper/faster model for background memory extraction (defaults to LLM_MODEL)
LLM_EXTRACTION_MODEL=
LLM_TEMPERATURE=0.7

# --- Optional: MLflow traces and eval history (README, "Tests and evals") ---
# Needs `uv sync --group observability` and a running `mlflow server`. Empty: tracing off.
MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=companion

# --- Companion embeddings (Lesson 19) ---
# RECOMMENDED for real use of the companion: the larger remote model, which separates related
# from unrelated memories far better (AUC 0.99 vs 0.85, Lesson 19). For DeepInfra, uncomment:
#   EMBED_BASE_URL=https://api.deepinfra.com/v1/openai
#   EMBED_MODEL=Qwen/Qwen3-Embedding-8B
# Empty: the local model (BAAI/bge-small-en-v1.5 on the CPU, no key, offline). Lessons 8-18's
# recorded numbers come from it, and Lessons 5-7 and the default tests always use it.
# Another model needs measured thresholds (companion/embeddings.py, Lesson 19).
# After switching, run: uv run python -m companion.reembed
EMBED_BASE_URL=
EMBED_MODEL=
# Defaults to LLM_API_KEY (same provider, same key)
EMBED_API_KEY=

# --- Companion memory (Lessons 8-12) ---
# Name of the person the companion talks to (one :User node per name)
COMPANION_USER=Alex
COMPANION_NAME=Sage
