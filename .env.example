# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- Neo4j (used by docker compose AND the Python scripts) ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- OpenAI-compatible chat endpoint (Lesson 5's graphrag.py answer, Lessons 7-12) ---
# Works with OpenAI, OpenRouter, Together, Groq, vLLM, Ollama (http://localhost:11434/v1),
# LM Studio (http://localhost:1234/v1), mlx_lm.server (http://localhost:8080/v1), ...
# The model must support tool calling for Lesson 7.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# Optional: a cheaper/faster model for background memory extraction (defaults to LLM_MODEL)
LLM_EXTRACTION_MODEL=
LLM_TEMPERATURE=0.7

# --- Companion memory (Lessons 8-12) ---
# Name of the person the companion talks to (one :User node per name)
COMPANION_USER=Alex
COMPANION_NAME=Sage
