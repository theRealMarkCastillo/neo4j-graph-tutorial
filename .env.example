# Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored; never commit real keys.

# --- Neo4j (used by docker compose AND the Python scripts) ---
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- LLM providers (optional; only needed for the generated answer in graphrag.py) ---
ANTHROPIC_API_KEY=
# Model used by graphrag.py
ANTHROPIC_MODEL=claude-opus-5-5
